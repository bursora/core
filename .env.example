# --- Database ---
# Self-host default: points at the bundled `postgres` service in docker-compose.yml.
# For local non-Docker dev, use postgres://postgres:postgres@localhost:5432/bursora_dev.
DATABASE_URL=postgres://bursora:bursora@postgres:5432/bursora
POSTGRES_USER=bursora
POSTGRES_PASSWORD=bursora
POSTGRES_DB=bursora

# --- Redis ---
# Bundled `redis` service in docker-compose.yml. Used for rate-limit counters
# and spike protection.
REDIS_URL=redis://redis:6379

# --- Mailhog (dev SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth ---
# Generate fresh values for self-host: `openssl rand -hex 32`.
BETTER_AUTH_SECRET=__REPLACE_ME__
BETTER_AUTH_URL=http://localhost:3000
BURSORA_API_KEY_PEPPER=__REPLACE_ME__

# --- Provider keys (server uses NONE; SDK consumers supply their own) ---
# Bursora SDK only — set in your customer app, not here.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Cron ---
# Shared bearer the `bursora-cron` sidecar presents to /api/cron/* routes.
# Generate a fresh random string in prod (`openssl rand -hex 32`).
CRON_SECRET=__REPLACE_ME__

# --- Build flavor ---
# Self-host default: `false`. Set to `true` for the Bursora cloud build to
# unlock billing UI, Stripe webhook, and the landing/legal pages.
IS_CLOUD=false

# --- Stripe (only required when IS_CLOUD=true) ---
# Create the Team product + price in the Stripe dashboard and paste the price
# id into STRIPE_PRICE_ID_TEAM. Run `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` for local webhook testing; the CLI prints
# a STRIPE_WEBHOOK_SECRET (whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_TEAM=
