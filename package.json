{
    "name": "@bursora/core",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev --port 3000",
        "build": "next build",
        "build:oss": "OSS_BUILD=true next build",
        "start": "next start --port 3000",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "next typegen && tsc --noEmit",
        "test": "bun test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
        "prepare": "husky",
        "db:generate": "drizzle-kit generate",
        "db:setup": "bun drizzle/setup.ts && bun clickhouse/migrate.ts --ensure-db",
        "db:migrate": "drizzle-kit migrate && bun run db:ch-migrate",
        "db:push": "drizzle-kit push",
        "db:seed": "bun drizzle/seed.ts",
        "db:reset": "bun run db:setup && bun run db:migrate && bun run db:seed",
        "db:fresh": "bun drizzle/setup.ts --fresh && bun clickhouse/migrate.ts --fresh && bun run db:migrate && bun run db:seed",
        "db:dev": "bun scripts/dev-setup.ts",
        "db:studio": "drizzle-kit studio",
        "db:ch-migrate": "bun clickhouse/migrate.ts"
    },
    "dependencies": {
        "@base-ui/react": "^1.5.0",
        "@clickhouse/client": "^1.20.0",
        "@hookform/resolvers": "^5.4.0",
        "@react-email/components": "^1.0.12",
        "@react-email/render": "^2.0.8",
        "@sentry/nextjs": "^10.56.0",
        "@shikijs/transformers": "^4.2.0",
        "@tailwindcss/postcss": "^4.3.0",
        "better-auth": "^1.6.14",
        "big.js": "^7.0.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "croner": "^10.0.1",
        "drizzle-orm": "^0.45.2",
        "input-otp": "^1.4.2",
        "ioredis": "^5.11.1",
        "lucide-react": "^1.17.0",
        "next": "^16.2.7",
        "next-themes": "^0.4.6",
        "nodemailer": "^8.0.10",
        "postcss": "^8.5.15",
        "postgres": "^3.4.9",
        "posthog-js": "^1.382.0",
        "radix-ui": "^1.5.0",
        "react": "^19.2.7",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.7",
        "react-hook-form": "^7.77.0",
        "react-hotkeys-hook": "^5.3.2",
        "react-markdown": "^10.1.0",
        "react-rough-notation": "^1.0.8",
        "recharts": "^3.8.1",
        "server-only": "^0.0.1",
        "shadcn": "^4.10.0",
        "shiki": "^4.2.0",
        "sonner": "^2.0.7",
        "swr": "^2.4.1",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.1",
        "@eslint/js": "^10.0.1",
        "@types/big.js": "^7.0.0",
        "@types/bun": "^1.3.14",
        "@types/node": "^25.9.2",
        "@types/nodemailer": "^8.0.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.4.1",
        "eslint-config-next": "^16.2.7",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7",
        "prettier": "^3.8.3",
        "prettier-plugin-organize-imports": "^4.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.1"
    },
    "engines": {
        "node": ">=18",
        "bun": ">=1.0"
    }
}
