# --- Database ---
# Self-host default: points at the bundled `postgres` service in docker-compose.yml.
# For local non-Docker dev, use postgres://postgres:postgres@localhost:5432/bursora_dev.
DATABASE_URL=postgres://bursora:bursora@postgres:5432/bursora
POSTGRES_USER=bursora
POSTGRES_PASSWORD=bursora
POSTGRES_DB=bursora

# --- Redis ---
# Required. Bundled `redis` service in docker-compose.yml. Backs request-id
# dedup on the ingest path, plus rate-limit counters and spike protection.
REDIS_URL=redis://redis:6379

# --- ClickHouse ---
# Usage-event store. Points at the bundled `clickhouse-server` service in
# docker-compose.yml. CLICKHOUSE_USER/PASSWORD/DATABASE default to
# `default`/empty/`default` and match the bundled server out of the box.
CLICKHOUSE_URL=http://clickhouse-server:8123
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DATABASE=default

# --- Mailhog (dev SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth ---
# Generate fresh values for self-host: `openssl rand -hex 32`.
BETTER_AUTH_SECRET=__REPLACE_ME__
BETTER_AUTH_URL=http://localhost:3000
BURSORA_API_KEY_PEPPER=__REPLACE_ME__
# AES-256-GCM key-encryption key, base64 of 32 random bytes. Seals API key
# plaintext at rest so workspace members can reveal/copy keys from the
# dashboard. Generate with `openssl rand -base64 32`.
BURSORA_KEY=__REPLACE_ME__
# CSRF allow-list for better-auth (comma-separated origins). Defaults to
# NEXT_PUBLIC_APP_URL plus localhost:3000, localhost:3001, and 127.0.0.1:3000
# (covers local dev across site/core ports). Set to override for preview
# deployments or secondary domains. Empty values fall back to the default.
# BETTER_AUTH_TRUSTED_ORIGINS=https://app.example.com,https://staging.example.com

# --- Google OAuth ---
# Register an OAuth client in Google Cloud Console and set the authorized
# redirect URI to `${BETTER_AUTH_URL}/api/auth/callback/google`.
GOOGLE_CLIENT_ID=__REPLACE_ME__
GOOGLE_CLIENT_SECRET=__REPLACE_ME__

# --- Provider keys (server uses NONE; SDK consumers supply their own) ---
# Bursora SDK only — set in your customer app, not here.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Build flavor ---
# Self-host default: `false`. Set to `true` for the Bursora cloud build to
# unlock billing UI, the Lemon Squeezy webhook, and the landing/legal pages.
IS_CLOUD=false

# --- Lemon Squeezy (only required when IS_CLOUD=true) ---
# Create the plan's product + variant in the Lemon Squeezy dashboard; the
# daily plan sync pulls the variant into the `plans` table by product id, so
# no variant env var is needed. LS signs webhooks with `X-Signature` (HMAC
# SHA-256 of the raw body under LEMONSQUEEZY_WEBHOOK_SECRET). Set
# LEMONSQUEEZY_WEBHOOK_SECRET_NEXT during secret rotation; the verifier accepts
# either while the rotation is in flight.
# LEMONSQUEEZY_MODE marks which LS environment the key + store target:
# `test` while the store is in test mode, `live` after activation. Defaults
# to `test`.
LEMONSQUEEZY_MODE=test
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET_NEXT=
LEMONSQUEEZY_STORE_ID=

# --- Error tracking (optional, opt-in) ---
# Paste your Sentry project DSN to capture server + edge errors. Leave empty
# (self-host default) to disable Sentry entirely: no init, nothing leaves the
# box. Read at runtime on the server, so setting it in the prod container env
# is enough.
SENTRY_DSN=
